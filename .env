# =========================================================================
# CONFIGURACIÓN DE APIS (DESARROLLO LOCAL)
# =========================================================================
# Instrucciones:
# - Si estás probando en la MISMA RED local (Wifi/LAN) donde corre el servidor,
#   usa la IP local de esa computadora (por ejemplo 192.168.1.X).
# - Si te llevas la laptop a OTRA RED (o reinicias el router), tu IP cambiará.
#   Tendrás que ejecutar `ipconfig` en Windows, buscar tu nueva "Dirección IPv4"
#   y actualizarla aquí.
# - NOTA: Cada vez que cambies algo en este archivo, DEBES reiniciar el
#   servidor de Expo limpiando la caché ejecutando: npx expo start -c
EXPO_PUBLIC_PILGRIM_API_URL=http://192.168.1.7:8000/api
EXPO_PUBLIC_USER_API_URL=http://192.168.1.7:8101

# =========================================================================
# CONFIGURACIÓN DE APIS (PRODUCCIÓN / NUBE)
# =========================================================================
# Instrucciones:
# - Cuando subas tu backend a un servidor en la nube (AWS, Render, Heroku, etc.)
#   o si tu app ya está compilada para el público, comenta las dos líneas
#   de arriba (poniendo un # al inicio) y descomenta las de abajo.
# - Reemplaza los dominios de ejemplo con las URLs reales de tu backend en producción.
# EXPO_PUBLIC_PILGRIM_API_URL=https://api.tu-dominio-laika.com/api
# EXPO_PUBLIC_USER_API_URL=https://auth.tu-dominio-laika.com
