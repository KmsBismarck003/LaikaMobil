# =========================================================================
# CONFIGURACIÓN DE APIS - LAIKA MOBIL & PILGRIM GATEWAY
# =========================================================================

# -------------------------------------------------------------------------
# OPCIÓN A (POR DEFECTO): AUTO-DETECCIÓN INTELIGENTE (CERO CONFIGURACIÓN)
# -------------------------------------------------------------------------
# Con "auto", la app detecta automáticamente la IP que el router o red Wi-Fi
# le asigne a tu laptop (sea 192.168.x.x o 10.x.x.x).
# Conexión directa y ultra rápida sin depender de túneles externos:
EXPO_PUBLIC_PILGRIM_API_URL=auto

# -------------------------------------------------------------------------
# OPCIÓN B: TÚNEL GLOBAL PARA CELULAR (DATOS MÓVILES 4G/5G)
# -------------------------------------------------------------------------
# Si tu celular usa datos móviles o estás en redes diferentes, ejecuta en tu PC:
#   iniciar_tunel_pilgrim.bat
# Y activa la URL fija (o cámbiala en caliente desde Perfil -> Ajustes):
# EXPO_PUBLIC_PILGRIM_API_URL=https://laika-pilgrim-dev.loca.lt/api

# NOTA ARQUITECTURAL:
# Pilgrim Gateway centraliza y enruta todos los microservicios (incluyendo usuarios).
# Al dejar vacía esta variable, se hereda automáticamente la URL de Pilgrim:
EXPO_PUBLIC_USER_API_URL=
