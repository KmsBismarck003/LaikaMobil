# =========================================================================
# CONFIGURACIÓN DE APIS - LAIKA MOBIL & PILGRIM GATEWAY
# =========================================================================

# -------------------------------------------------------------------------
# PILGRIM API GATEWAY - PRODUCCIÓN (AZURE CLOUD HTTPS)
# -------------------------------------------------------------------------
# Conectado directamente a la infraestructura cloud activa en Azure:
EXPO_PUBLIC_PILGRIM_API_URL=https://laikaclub-nzhwq8.southcentralus.cloudapp.azure.com/api

# Soporte defensivo para configuraciones que usan prefijo VITE_:
VITE_PILGRIM_API_URL=https://laikaclub-nzhwq8.southcentralus.cloudapp.azure.com/api

# -------------------------------------------------------------------------
# DESARROLLO LOCAL ALTERNATIVO (OPCIONAL)
# -------------------------------------------------------------------------
# Si deseas volver a desarrollo en red local Wi-Fi, descomentar la siguiente línea:
# EXPO_PUBLIC_PILGRIM_API_URL=auto

# NOTA ARQUITECTURAL:
# Pilgrim Gateway centraliza y enruta todos los microservicios (incluyendo usuarios).
# Al dejar vacía esta variable, se hereda automáticamente la URL de Pilgrim:
EXPO_PUBLIC_USER_API_URL=
